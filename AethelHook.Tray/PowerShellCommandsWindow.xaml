<Window x:Class="AethelHook.Tray.PowerShellCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerShell Commands" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Run these from an elevated PowerShell window."
                   TextWrapping="Wrap" Margin="0,0,0,16" />

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Check if it is running" FontWeight="Bold" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2" Margin="8,0,0,0"
                        Tag="Get-Service AethelHook" Click="Copy_Click" />
                <TextBox Text="Get-Service AethelHook" IsReadOnly="True" FontFamily="Consolas"
                         VerticalContentAlignment="Center" Padding="4" />
            </DockPanel>
            <TextBlock Text="Use this to see if the service is Running or Stopped." TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Start it" FontWeight="Bold" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2" Margin="8,0,0,0"
                        Tag="Start-Service AethelHook" Click="Copy_Click" />
                <TextBox Text="Start-Service AethelHook" IsReadOnly="True" FontFamily="Consolas"
                         VerticalContentAlignment="Center" Padding="4" />
            </DockPanel>
            <TextBlock Text="Use this if the service did not start on its own." TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Stop it" FontWeight="Bold" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2" Margin="8,0,0,0"
                        Tag="Stop-Service AethelHook" Click="Copy_Click" />
                <TextBox Text="Stop-Service AethelHook" IsReadOnly="True" FontFamily="Consolas"
                         VerticalContentAlignment="Center" Padding="4" />
            </DockPanel>
            <TextBlock Text="Use this to turn the gateway off." TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>

        <StackPanel Margin="0,0,0,4">
            <TextBlock Text="Restart it" FontWeight="Bold" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2" Margin="8,0,0,0"
                        Tag="Restart-Service AethelHook" Click="Copy_Click" />
                <TextBox Text="Restart-Service AethelHook" IsReadOnly="True" FontFamily="Consolas"
                         VerticalContentAlignment="Center" Padding="4" />
            </DockPanel>
            <TextBlock Text="Use this if the service is running but not responding." TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
    </StackPanel>
</Window>
